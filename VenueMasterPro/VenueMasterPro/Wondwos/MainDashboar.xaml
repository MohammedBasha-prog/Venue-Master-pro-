<Window x:Class="VenueMasterPro.MainDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VenueMasterPro"
        mc:Ignorable="d"
        Title="Venue Master Pro - لوحة التحكم الرئيسية" 
        Height="720" Width="1180"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <!-- تأثير ظل فخم للنافذة -->
        <DropShadowEffect x:Key="WindowShadow" BlurRadius="35" ShadowDepth="8" Direction="270" Opacity="0.3"/>

        <!-- ستايل الأزرار الجانبية الأساسية (مرتبة بحيث تضمن أن الأيقونة أولاً ثم النص بدقة) -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF94A3B8"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF1E293B"/>
                    <Setter Property="Foreground" Value="#FFFFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ستايل الخيارات الفرعية للقائمة المنسدلة -->
        <Style x:Key="SubMenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFCBD5E1"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="25,0,15,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF1E293B"/>
                    <Setter Property="Foreground" Value="#FFFFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- الحاوية الرئيسية الشفافة -->
    <Grid Background="Transparent">

        <!-- إطار النافذة الرئيسي -->
        <Border Background="#FF0F172A" 
                BorderBrush="#FF3B82F6" 
                BorderThickness="1.5"
                CornerRadius="16" 
                Effect="{StaticResource WindowShadow}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- العمود الأول (في اليمين): البانل الجانبي بعرض 260 -->
                    <ColumnDefinition Width="260"/>
                    <!-- العمود الثاني (في اليسار): مساحة المحتوى -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ================= 1. البانل الجانبي (ملتصق تماماً بالحافة اليمنى) ================= -->
                <Border Grid.Column="0" Background="#FF090D16" CornerRadius="16,0,0,16" Padding="0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- شعار النظام -->
                            <RowDefinition Height="*"/>
                            <!-- أزرار القائمة -->
                        </Grid.RowDefinitions>

                        <!-- أ. شعار النظام -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,15" HorizontalAlignment="Stretch">
                            <Grid HorizontalAlignment="Right" Margin="0,0,15,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0" HorizontalAlignment="Right">
                                    <TextBlock Text="Venue Master" FontSize="15" FontWeight="Bold" Foreground="White" TextAlignment="Right"/>
                                    <TextBlock Text="Pro Edition" FontSize="11" Foreground="#FF3B82F6" TextAlignment="Right"/>
                                </StackPanel>

                                <Border Grid.Column="1" Width="42" Height="42" CornerRadius="12" Background="#FFE0F2FE" HorizontalAlignment="Right">
                                    <TextBlock Text="🏛️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <Separator Background="#FF1E293B" Height="1" Margin="15,12,15,0" HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <!-- ب. أزرار القائمة والتحكم (الأيقونات تحت بعضها تماماً وبعدها الكلام مرتب في اليمين) -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel HorizontalAlignment="Stretch">

                                <!-- زر لوحة التحكم -->
                                <Button x:Name="btnDashboard" Style="{StaticResource MenuButtonStyle}" Margin="0,0,0,2">
                                    <Grid Width="230">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="📊" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="لوحة التحكم" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="-1.71,0.795" Width="200"/>
                                    </Grid>
                                </Button>

                                <!-- زر إدارة الحجوزات -->
                                <Button Style="{StaticResource MenuButtonStyle}" Margin="0,0,0,2">
                                    <Grid Width="230">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="📅" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="إدارة الحجوزات" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" Width="200"/>
                                    </Grid>
                                </Button>

                                <!-- زر القاعات والصالات -->
                                <Button Style="{StaticResource MenuButtonStyle}" Margin="0,0,0,2">
                                    <Grid Width="230">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🏛️" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="القاعات والصالات" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" Width="200"/>
                                    </Grid>
                                </Button>

                                <!-- زر العملاء والنزلاء -->
                                <Button Style="{StaticResource MenuButtonStyle}" Margin="0,0,0,2">
                                    <Grid Width="230">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="👥" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="العملاء والنزلاء" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" Width="200"/>
                                    </Grid>
                                </Button>

                                <!-- زر المالية والحسابات -->
                                <Button Style="{StaticResource MenuButtonStyle}" Margin="0,0,0,2">
                                    <Grid Width="230">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="💰" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="المالية والحسابات" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" Width="200"/>
                                    </Grid>
                                </Button>

                                <!-- زر إعدادات النظام -->
                                <Button Style="{StaticResource MenuButtonStyle}" Margin="0,0,0,8">
                                    <Grid Width="230">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="⚙️" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" Width="22"/>
                                        <TextBlock Grid.Column="1" Text="إعدادات النظام" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left" Width="90"/>
                                    </Grid>
                                </Button>

                                <!-- قسم الحسابات والإدارة (مع سهم القائمة المنسدلة 🔽) -->
                                <Border Background="#FF090D16" HorizontalAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Stretch">

                                        <!-- زر إدارة الحساب الرئيسي -->
                                        <Button Style="{StaticResource MenuButtonStyle}" Click="BtnAccountMenu_Click" HorizontalAlignment="Stretch">
                                            <Grid Width="230">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- الأيقونة في أقصى اليمين -->
                                                <TextBlock Grid.Column="0" Text="👤" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <!-- النص بجانبها -->
                                                <TextBlock Grid.Column="1" Text="إدارة الحساب" FontSize="14" FontWeight="SemiBold" Foreground="#FF94A3B8" VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="200" Margin="0,0,0,1"/>
                                                <!-- علامة السهم المنسدل -->
                                                <TextBlock x:Name="txtArrow" Grid.Column="1" Text="▼" Foreground="#FF3B82F6" FontSize="10" VerticalAlignment="Center" Margin="85,0,0,0" Grid.ColumnSpan="2"/>
                                            </Grid>
                                        </Button>

                                        <!-- خيارات الحساب المنسدلة -->
                                        <StackPanel x:Name="pnlAccountSubMenu" Visibility="Collapsed" Margin="0,2,0,0" HorizontalAlignment="Stretch" Background="#FF05080E">

                                            <!-- إضافة حساب -->
                                            <Button x:Name="btnAddAccount" Style="{StaticResource SubMenuButtonStyle}" Margin="0,0,0,2" Click="BtnAddAccount_Click">
                                                <Grid Width="210">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="25"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="➕" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="إضافة حساب جديد" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Button>

                                            <!-- تعديل الحساب -->
                                            <Button Style="{StaticResource SubMenuButtonStyle}" Margin="0,0,0,2" Click="BtnEditAccount_Click">
                                                <Grid Width="210">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="25"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="✏️" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="تعديل الحساب" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Button>

                                            <!-- تسجيل الخروج (أحمر) -->
                                            <Button Style="{StaticResource SubMenuButtonStyle}" Click="BtnLogout_Click">
                                                <Grid Width="210">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="25"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="🚪" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="تسجيل الخروج" FontSize="13" Foreground="#FFF87171" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Button>
                                        </StackPanel>

                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                    </Grid>
                </Border>

                <!-- ================= 2. محتوى النافذة الرئيسي (في اليسار) ================= -->
                <Grid Grid.Column="1" Margin="25">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- أ. الشريط العلوي (TitleBar) -->
                    <Grid Grid.Row="0" Height="45" MouseDown="HeaderGrid_MouseDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="مرحباً بك، لوحة إدارة القاعات" FontSize="16" FontWeight="SemiBold" Foreground="#FFF1F5F9" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,14,608,0"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="🗕" Width="32" Height="28" Background="Transparent" Foreground="#FF94A3B8" BorderBrush="Transparent" Cursor="Hand" Click="BtnMinimize_Click"/>
                            <Button Content="✕" Width="32" Height="28" Background="Transparent" Foreground="#FFF87171" BorderBrush="Transparent" Cursor="Hand" FontWeight="Bold" Click="BtnClose_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- ب. مساحة عرض المحتوى -->
                    <Grid Grid.Row="1" Margin="0,15,0,0">
                        <Border Background="#FF1E293B" CornerRadius="14" Padding="25">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ContentControl x:Name="MainContentArea"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>