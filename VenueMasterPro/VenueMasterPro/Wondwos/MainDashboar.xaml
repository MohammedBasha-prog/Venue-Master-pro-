<Window x:Class="VenueMasterPro.MainDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VenueMasterPro"
        mc:Ignorable="d"
        Title="Venue Master Pro - لوحة التحكم الرئيسية" 
        Height="720" Width="1180"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <!-- نفس تأثير ظل البطاقة في MainWindow -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="35" ShadowDepth="8" Direction="270" Opacity="0.25"/>

        <!-- ستايل الأزرار الجانبية الأساسية -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF334155"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Margin="8,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE0F2FE"/>
                    <Setter Property="Foreground" Value="#FF1E3A8A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ستايل الخيارات الفرعية للقائمة المنسدلة -->
        <Style x:Key="SubMenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF475569"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="22,0,12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Margin="12,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE0F2FE"/>
                    <Setter Property="Foreground" Value="#FF1E3A8A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- الحاوية الرئيسية الشفافة -->
    <Grid Background="Transparent" Margin="15">

        <!-- إطار النافذة الرئيسي بنفس إطار وبطاقة MainWindow -->
        <Border Background="#FFFFFFFF" 
                BorderBrush="#FF3B82F6" 
                BorderThickness="1.5"
                CornerRadius="20" 
                Effect="{StaticResource CardShadow}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- العمود الأول (في اليمين): البانل الجانبي -->
                    <ColumnDefinition Width="260"/>
                    <!-- العمود الثاني (في اليسار): مساحة المحتوى -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ================= 1. البانل الجانبي ================= -->
                <Border Grid.Column="0"
                        Background="#FFF8FAFC"
                        BorderBrush="#FFCBD5E1"
                        BorderThickness="0,0,1,0"
                        CornerRadius="0,20,20,0"
                        Padding="0,20" Margin="4,10,873,10" Grid.ColumnSpan="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- أ. شعار النظام -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,15" HorizontalAlignment="Stretch">
                            <Grid Margin="15,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0" HorizontalAlignment="Right">
                                    <TextBlock Text="Venue Master" FontSize="15" FontWeight="Bold" Foreground="#FF1E3A8A" TextAlignment="Right"/>
                                    <TextBlock Text="Pro Edition" FontSize="11" Foreground="#FF3B82F6" TextAlignment="Right"/>
                                </StackPanel>

                                <Border Grid.Column="1" Width="42" Height="42" CornerRadius="12" Background="#FFE0F2FE" VerticalAlignment="Center">
                                    <TextBlock Text="🏛️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <Separator Background="#FFCBD5E1" Height="1" Margin="15,12,15,0" HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <!-- ب. أزرار القائمة والتحكم -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>

                                <!-- زر لوحة التحكم -->
                                <Button x:Name="btnDashboard" Style="{StaticResource MenuButtonStyle}" Margin="0,0,0,2" Click="btnDashboard_Click_1">
                                    <Grid Width="210">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="📊" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="لوحة التحكم" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" Width="170"/>
                                    </Grid>
                                </Button>

                                <!-- زر إدارة الحجوزات -->
                                <Button Style="{StaticResource MenuButtonStyle}" Margin="0,0,0,2">
                                    <Grid Width="210">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="📅" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="إدارة الحجوزات" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" Width="170"/>
                                    </Grid>
                                </Button>

                                <!-- زر القاعات والصالات -->
                                <Button Style="{StaticResource MenuButtonStyle}" Margin="0,0,0,2">
                                    <Grid Width="210">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🏛️" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="القاعات والصالات" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" Width="170"/>
                                    </Grid>
                                </Button>

                                <!-- زر العملاء والنزلاء -->
                                <Button Style="{StaticResource MenuButtonStyle}" Margin="0,0,0,2">
                                    <Grid Width="210">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="👥" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="العملاء والنزلاء" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" Width="170"/>
                                    </Grid>
                                </Button>

                                <!-- زر المالية والحسابات -->
                                <Button Style="{StaticResource MenuButtonStyle}" Margin="0,0,0,2">
                                    <Grid Width="210">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="💰" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="المالية والحسابات" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" Width="170"/>
                                    </Grid>
                                </Button>

                                <!-- ================= قسم إعدادات النظام (منسدل) ================= -->
                                <Border Background="Transparent" HorizontalAlignment="Stretch" Margin="0,0,0,4">
                                    <StackPanel HorizontalAlignment="Stretch">

                                        <!-- زر إعدادات النظام الرئيسي -->
                                        <Button Style="{StaticResource MenuButtonStyle}" Click="BtnSettingsMenu_Click" HorizontalAlignment="Stretch">
                                            <Grid Width="210" RenderTransformOrigin="0.421,0.425">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="⚙️" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="إعدادات النظام" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" Width="151"/>
                                                <TextBlock x:Name="txtSettingsArrow" Grid.Column="2" Text="▼" Foreground="#FF3B82F6" FontSize="10" VerticalAlignment="Center" Margin="2,0,8,0"/>
                                            </Grid>
                                        </Button>

                                        <!-- خيارات الإعدادات المنسدلة -->
                                        <StackPanel x:Name="pnlSettingsSubMenu" Visibility="Collapsed" Margin="0,4,0,0" HorizontalAlignment="Stretch">

                                            <!-- إدارة الصلاحيات -->
                                            <Button x:Name="btnPermissions" Style="{StaticResource SubMenuButtonStyle}" Margin="0,0,0,2" Click="BtnPermissions_Click">
                                                <Grid Width="195">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="25"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="🛡️" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="إدارة الصلاحيات" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="6,0,0,0"/>
                                                </Grid>
                                            </Button>

                                            <!-- إدارة الأدوار والصلاحيات -->
                                            <Button x:Name="btnRoles" Style="{StaticResource SubMenuButtonStyle}" Margin="0,0,0,2" Click="BtnRoles_Click">
                                                <Grid Width="195">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="25"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="🔑" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="الأدوار الوظيفية والصلاحيات" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="6,0,0,0"/>
                                                </Grid>
                                            </Button>

                                            <!-- إضافة مستخدم -->
                                            <Button x:Name="btnAddUser" Style="{StaticResource SubMenuButtonStyle}" Margin="0,0,0,2" Click="BtnAddAccount_Click">
                                                <Grid Width="195">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="25"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="➕" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="إضافة مستخدم" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="6,0,0,0"/>
                                                </Grid>
                                            </Button>

                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ================= قسم الحسابات والإدارة ================= -->
                                <Border Background="Transparent" HorizontalAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Stretch">

                                        <!-- زر إدارة الحساب الرئيسي -->
                                        <Button Style="{StaticResource MenuButtonStyle}" Click="BtnAccountMenu_Click" HorizontalAlignment="Stretch">
                                            <Grid Width="210">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="👤" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="إدارة الحساب" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" Width="151"/>
                                                <TextBlock x:Name="txtArrow" Grid.Column="2" Text="▼" Foreground="#FF3B82F6" FontSize="10" VerticalAlignment="Center" Margin="2,0,8,0"/>
                                            </Grid>
                                        </Button>

                                        <!-- خيارات الحساب المنسدلة -->
                                        <StackPanel x:Name="pnlAccountSubMenu" Visibility="Collapsed" Margin="0,4,0,0" HorizontalAlignment="Stretch">

                                            <!-- تعديل الحساب -->
                                            <Button Style="{StaticResource SubMenuButtonStyle}" Margin="0,0,0,2" Click="BtnEditAccount_Click">
                                                <Grid Width="195">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="25"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="✏️" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="تعديل الحساب" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="6,0,0,0"/>
                                                </Grid>
                                            </Button>

                                            <!-- تسجيل الخروج -->
                                            <Button Style="{StaticResource SubMenuButtonStyle}" Click="BtnLogout_Click">
                                                <Grid Width="195">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="25"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="🚪" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="تسجيل الخروج" FontSize="13" Foreground="#FFDC2626" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="6,0,0,0"/>
                                                </Grid>
                                            </Button>

                                        </StackPanel>

                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                    </Grid>
                </Border>

                <!-- ================= 2. محتوى النافذة الرئيسي ================= -->
                <Grid Grid.Column="1" Margin="25">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    
                    <!-- أ. الشريط العلوي (TitleBar) -->
                    <Grid Grid.Row="0" Height="45" MouseDown="HeaderGrid_MouseDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="مرحباً بك، لوحة إدارة القاعات"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#FF1E3A8A"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Right" Margin="0,8,556,0"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="🗕" Width="32" Height="28" Background="Transparent" Foreground="#FF64748B" BorderBrush="Transparent" Cursor="Hand" Click="BtnMinimize_Click"/>
                            <Button Content="✕" Width="32" Height="28" Background="Transparent" Foreground="#FFDC2626" BorderBrush="Transparent" Cursor="Hand" FontWeight="Bold" Click="BtnClose_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- ب. مساحة عرض المحتوى -->
                    <Border Grid.Row="1"
                            Margin="0,10,0,0"
                            Background="#FFF8FAFC"
                            BorderBrush="#FFCBD5E1"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="20">
                        <ContentControl x:Name="MainContentArea"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch" Margin="-11,-11,-11,-11"/>
                    </Border>

                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>