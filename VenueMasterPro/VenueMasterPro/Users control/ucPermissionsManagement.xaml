<UserControl x:Class="VenueMasterPro.ucPermissionsManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="580" d:DesignWidth="840"
             FlowDirection="RightToLeft"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <!-- ستايل مربعات النصوص -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FFCBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#FF3B82F6"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ستايل الأزرار الرئيسية -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FF2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="15,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. ترويسة الصفحة -->
        <Border Grid.Row="0" Background="#FFFFFFFF" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,15">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="#FFE0F2FE" Margin="0,0,12,0">
                        <TextBlock Text="🛡️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="إدارة صلاحيات النظام" FontSize="17" FontWeight="Bold" Foreground="#FF1E3A8A"/>
                        <TextBlock Text="إضافة وتعديل الصلاحيات البرمجية والتحكم في حالتها" FontSize="12" Foreground="#FF64748B"/>
                    </StackPanel>
                </StackPanel>

                <!-- عداد الصلاحيات -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Center" Background="#FFEFF6FF" BorderBrush="#FFBFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="637,0,0,0" Width="142">
                    <TextBlock x:Name="lblTotalCount" Text="إجمالي الصلاحيات: 0" FontSize="12" FontWeight="SemiBold" Foreground="#FF1E40AF" Margin="-6,0,-3,0"/>
                </Border>
            </Grid>
        </Border>

        <!-- 2. المحتوى الرئيسي (نموذج الإدخال يمين + الجدول يسار) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- أ. بطاقة الإضافة والتعديل -->
            <Border Grid.Column="0" Background="#FFFFFFFF" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="12" Padding="18">
                <StackPanel>
                    <TextBlock x:Name="lblFormTitle" Text="➕ إضافة صلاحية جديدة" FontSize="15" FontWeight="Bold" Foreground="#FF1E3A8A" Margin="0,0,0,15"/>

                    <!-- رقم الصلاحية (للعرض فقط عند التعديل) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="رقم الصلاحية:" FontSize="12" Foreground="#FF64748B" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblPermissionID" Text="[جديد]" FontSize="12" FontWeight="Bold" Foreground="#FF2563EB" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- اسم الصلاحية -->
                    <TextBlock Text="اسم الصلاحية *" FontSize="12" FontWeight="SemiBold" Foreground="#FF334155" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtPermissionName" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>

                    <!-- الكود البرمجي -->
                    <TextBlock Text="الكود البرمجي (Code) *" FontSize="12" FontWeight="SemiBold" Foreground="#FF334155" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtPermissionCode" Style="{StaticResource ModernTextBox}" FlowDirection="LeftToRight" Margin="0,0,0,12"/>

                    <!-- الوصف -->
                    <TextBlock Text="وصف الصلاحية" FontSize="12" FontWeight="SemiBold" Foreground="#FF334155" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtDescription" Height="70" Padding="10,8" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalContentAlignment="Top" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>

                    <!-- حالة التفعيل -->
                    <CheckBox x:Name="chkIsActive" Content="الصلاحية مفعلة ونشطة في النظام" IsChecked="True" 
                              FontSize="13" Foreground="#FF334155" Margin="0,4,0,20" Cursor="Hand"/>

                    <!-- أزرار الحفظ والإلغاء -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnSave" Grid.Column="0" Content="💾 حفظ البيانات" Style="{StaticResource PrimaryButton}" Click="BtnSave_Click"/>

                        <Button x:Name="btnClear" Grid.Column="2" Content="🔄 جديد" Height="40" Padding="14,0" Cursor="Hand"
                                Background="#FFF1F5F9" Foreground="#FF475569" BorderBrush="#FFCBD5E1" BorderThickness="1" Click="BtnClear_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ب. بطاقة عرض الصلاحيات والبحث -->
            <Border Grid.Column="2" Background="#FFFFFFFF" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="12" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="105*"/>
                        <ColumnDefinition Width="373*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- شريط البحث والفلترة -->
                    <Grid Grid.Row="0" Margin="0,0,0,12" Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="txtSearch" Grid.Column="0" Style="{StaticResource ModernTextBox}" 
                                 Tag="بحث باسم الصلاحية أو الكود..." TextChanged="TxtSearch_TextChanged"/>

                        <CheckBox x:Name="chkOnlyActiveFilter" Grid.Column="2" Content="المفعلة فقط" VerticalAlignment="Center"
                                  FontSize="12" Foreground="#FF475569" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                    </Grid>

                    <!-- جدول البيانات -->
                    <DataGrid x:Name="dgvPermissions" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" CanUserAddRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FFF1F5F9"
                              Background="White" BorderBrush="#FFE2E8F0" BorderThickness="1" RowHeight="38"
                              SelectionChanged="DgvPermissions_SelectionChanged" Grid.ColumnSpan="2">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FFF8FAFC"/>
                                <Setter Property="Foreground" Value="#FF1E3A8A"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Height" Value="38"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="BorderBrush" Value="#FFE2E8F0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding PermissionID}" Width="45"/>
                            <DataGridTextColumn Header="اسم الصلاحية" Binding="{Binding PermissionName}" Width="90"/>
                            <DataGridTextColumn Header="الكود البرمجي" Binding="{Binding PermissionCode}" Width="140"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="75"/>
                            <DataGridTextColumn Header="الأدوار" Binding="{Binding AssignedRolesCount}" Width="60"/>

                            <!-- عمود الإجراءات (تعديل / حذف) -->
                            <DataGridTemplateColumn Header="إجراءات" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="✏️" ToolTip="تعديل" Background="Transparent" BorderThickness="0" 
                                                    Cursor="Hand" Margin="2,0" Click="BtnGridEdit_Click"/>
                                            <Button Content="🗑️" ToolTip="حذف / تعطيل" Background="Transparent" BorderThickness="0" 
                                                    Cursor="Hand" Margin="2,0" Click="BtnGridDelete_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>